# =========================================================
# BINARY / GENERATED FILES
# =========================================================

# Prevent Git from treating these as text
*.pdb -text
*.lib -text
*.a -text
*.o -text
*.obj -text


# =========================================================
# FILES THAT SHOULD NEVER BE MERGED AS TEXT
# =========================================================

*.bin -text
*.bytes -text
*.dll -text
*.so -text
*.dylib -text
*.exe -text
*.apk -text
*.aab -text
*.ipa -text
