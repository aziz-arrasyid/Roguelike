# =========================================================
# Unity - .gitattributes
# Git + Git LFS configuration
# =========================================================


# =========================================================
# TEXT FILES
# =========================================================

# Default: automatically detect text files
* text=auto

# C# / Scripts
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf

# Shaders
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.raytrace text eol=lf

# Configuration / Data
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.config text eol=lf
*.properties text eol=lf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# Unity YAML files
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.mask text eol=lf

# Unity metadata
*.meta text eol=lf

# Localization / Text data
*.po text eol=lf
*.strings text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Documentation
*.rst text eol=lf
*.log text eol=lf


# =========================================================
# UNITY / PACKAGE / TOOL CONFIGURATION
# =========================================================

# Unity Package Manager
package.json text eol=lf
packages-lock.json text eol=lf

# Assembly definitions
*.asmdef text eol=lf
*.asmref text eol=lf

# Version files
ProjectVersion.txt text eol=lf
EditorBuildSettings.asset text eol=lf


